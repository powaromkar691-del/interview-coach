# Required for production. Use the MongoDB Atlas connection string.
MONGO_URL=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=interview_coach

# Set a unique, random value (at least 32 characters) in Render.
JWT_SECRET_KEY=replace-with-a-long-random-secret
TOKEN_TTL_HOURS=24
APP_ENV=development

# Optional. Without a key, the app uses its existing structured fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Exact frontend origin(s), comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
